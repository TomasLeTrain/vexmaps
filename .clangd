CompileFlags:
  Add: [
    -std=c++23,
    -isystem/usr/lib/clang/19/include,
    "-isystem/usr/lib/gcc/arm-none-eabi/14.2.1/../../../../arm-none-eabi/include/c++/14.2.1",
    "-isystem/usr/lib/gcc/arm-none-eabi/14.2.1/../../../../arm-none-eabi/include/c++/14.2.1/arm-none-eabi/thumb/v7-a+simd/hard",
    "-isystem/usr/lib/gcc/arm-none-eabi/14.2.1/../../../../arm-none-eabi/include/c++/14.2.1/backward",
    "-isystem/usr/lib/gcc/arm-none-eabi/14.2.1/include",
    "-isystem/usr/lib/gcc/arm-none-eabi/14.2.1/include-fixed",
    "-isystem/usr/lib/gcc/arm-none-eabi/14.2.1/../../../../arm-none-eabi/include",

    ]
  Remove: [ -isystem*, --std=gnu++23, -mfp16-format=ieee ]
